{/* FORMULAIRE */}
      <div className="pt-40 md:pt-48 pb-20 px-6 bg-[#fafafa]">
        <div className="max-w-[980px] mx-auto">
          <div className="bg-white rounded-[32px] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.2)] border border-slate-200/60 p-8 md:p-10">
            <div className="flex items-center justify-between mb-8">
              <div>
                <h2 className="text-[28px] font-semibold tracking-tight text-slate-900">Trouver mon véhicule</h2>
                <p className="text-sm text-slate-500 mt-1">Location et vente, même plateforme</p>
              </div>
              <div className="flex bg-slate-100 p-1 rounded-2xl">
                {["Louer", "Acheter"].map(tab => (
                  <button key={tab} onClick={() => { setActiveTab(tab); setSearchResults(null) }} className={`px-6 py-2.5 rounded-xl text-[13px] font-medium transition-all ${activeTab===tab? "bg-slate-900 text-white shadow-md" : "text-slate-600 hover:text-slate-900"}`}>
                    {tab}
                  </button>
                ))}
              </div>
            </div>

            {isRental? (
              <div className="space-y-4">
                <div className="grid md:grid-cols-2 gap-4">
                  <div className="relative">
                    <MapPin className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" size={18} />
                    <input value={rentalLocation} onChange={e=>setRentalLocation(e.target.value)} placeholder="Lieu de prise en charge" className="w-full pl-11 pr-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-[14px] focus:outline-none focus:ring-2 focus:ring-slate-900/20 focus:border-slate-900 transition-all" />
                  </div>
                  <div className="grid grid-cols-2 gap-3">
                    <input type="date" value={startDate} onChange={e=>setStartDate(e.target.value)} className="px-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-[14px] focus:outline-none focus:ring-2 focus:ring-slate-900/20" />
                    <input type="date" value={endDate} onChange={e=>setEndDate(e.target.value)} className="px-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-[14px] focus:outline-none focus:ring-2 focus:ring-slate-900/20" />
                  </div>
                </div>
                <div className="grid md:grid-cols-3 gap-4">
                  <select value={withDriver} onChange={e=>setWithDriver(e.target.value)} className="px-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-[14px] focus:outline-none">
                    <option>Sans chauffeur</option>
                    <option>Avec chauffeur</option>
                  </select>
                  <select className="px-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-[14px]">
                    <option>Berline</option>
                    <option>SUV</option>
                    <option>4x4</option>
                    <option>Minibus</option>
                  </select>
                  <button onClick={handleSearch} className="bg-slate-900 hover:bg-black text-white rounded-2xl py-4 font-medium text-[14px] flex items-center justify-center gap-2 transition-all hover:shadow-xl hover:-translate-y-0.5">
                    <Search size={18} /> Rechercher
                  </button>
                </div>
              </div>
            ) : (
              <div className="space-y-4">
                <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                  {Object.keys(dropdownData).map(filter => (
                    <div key={filter} className="relative">
                      <button onClick={()=>setActiveDropdown(activeDropdown===filter?null:filter)} className="w-full px-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-[14px] flex justify-between items-center hover:border-slate-300 transition-all">
                        <span className="truncate text-slate-700">{selections[filter] || filter}</span>
                        <ChevronDown size={16} className="text-slate-400" />
                      </button>
                      {activeDropdown===filter && (
                        <div className="absolute top-full mt-2 w-full bg-white border border-slate-200 rounded-2xl shadow-2xl z-50 overflow-hidden">
                          {dropdownData[filter].map(item => (
                            <button key={item} onClick={()=>{setSelections({...selections,[filter]:item}); setActiveDropdown(null)}} className="w-full text-left px-4 py-3 text-[14px] hover:bg-slate-900 hover:text-white transition-colors">{item}</button>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
                <div className="grid md:grid-cols-2 gap-4">
                  <InteractiveSlider label="Année min" value={year} onChange={setYear} min={2018} max={2025} format={v=>v} />
                  <InteractiveSlider label="Budget max" value={budget/1000000} onChange={v=>setBudget(v*1000000)} min={5} max={100} format={v=>`${v}M FCFA`} />
                </div>
                <button onClick={handleSearch} className="w-full bg-slate-900 hover:bg-black text-white rounded-2xl py-4 font-medium text-[14px] flex items-center justify-center gap-2 transition-all hover:shadow-xl">
                  <Search size={18} /> Voir les véhicules disponibles
                </button>
              </div>
            )}
          </div>
        </div>
      </div>
      {/* RÉSULTATS */}
      <div ref={resultsRef} className="px-6 py-20 bg-[#fafafa]">
        <div className="max-w-7xl mx-auto">
          {searchResults? (
            <>
              <div className="flex justify-between items-end mb-10">
                <h2 className="text-[32px] font-semibold tracking-tight text-slate-900">{searchResults.length} véhicules trouvés</h2>
                <button onClick={()=>setSearchResults(null)} className="text-[13px] text-slate-500 hover:text-slate-900 underline underline-offset-4">Réinitialiser</button>
              </div>
              <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {searchResults.map(car => <CarCard key={car.id} car={car} />)}
              </div>
            </>
          ) : (
            <SectionPopulaires cars={mockCars} CarCard={CarCard} />
          )}
      </div>
      </div>